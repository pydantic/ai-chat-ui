{
  "name": "@pydantic/ai-chat-ui",
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pydantic/ai-chat-ui.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "version": "2.3.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write",
    "lint": "eslint",
    "lint-fix": "eslint --fix --quiet",
    "dev": "BACKEND_PORT=38001 vite",
    "dev:server": "cd agent && uv run uvicorn chatbot.server:app --port 38001",
    "gen:constants": "cd agent && uv run python scripts/gen_constants.py",
    "build": "tsc -b && vite build",
    "build:offline": "tsc -b && vite build --mode offline",
    "preview": "vite preview",
    "test": "pnpm test:headless && pnpm test:e2e",
    "test:headless": "vitest run --config vitest.config.ts",
    "test:e2e": "E2E_TEST_DIR=tests/e2e/deterministic playwright test",
    "test:e2e:llm": "E2E_TEST_DIR=tests/e2e/llm playwright test",
    "test:e2e:ui": "E2E_TEST_DIR=tests/e2e/deterministic playwright test --ui",
    "test:e2e:offline": "pnpm run build:offline && playwright test --config playwright.offline.config.ts",
    "test:server": "cd tests/server && uv run uvicorn server:app --host 127.0.0.1 --port 38787",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "files": [
    "dist",
    "offline"
  ],
  "dependencies": {
    "@ai-sdk/react": "^4.0.177",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@uidotdev/usehooks": "^2.4.1",
    "ai": "^7.0.173",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.73.0",
    "nanoid": "^6.0.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-sanitize": "^6.0.0",
    "sonner": "^2.0.8",
    "streamdown": "^1.6.11",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/npm": "^13.2.0",
    "@taplo/cli": "^0.7.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "cspell": "^10.5.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.1",
    "neostandard": "^0.14.1",
    "prettier": "^3.10.1",
    "semantic-release": "^26.0.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-bundle-analyzer": "^1.3.9",
    "vite-plugin-singlefile": "^2.3.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0",
    "yaml-lint": "^1.7.0"
  }
}
